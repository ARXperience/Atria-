// Atria Hospitality OS — esquema de datos (Atria Core + PMS + Booking + Connect + Pay + Compliance)
// SQLite por defecto; compatible con PostgreSQL cambiando datasource.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== Atria Core =====================

model Company {
  id          String   @id @default(cuid())
  name        String
  nit         String   @unique
  legalRep    String?
  address     String?
  city        String?
  email       String?
  phone       String?
  fiscalRegime String?
  active      Boolean  @default(true)
  // Suscripción SaaS (§55.1)
  planCode        String   @default("trial")
  subStatus       String   @default("trial") // trial | active | suspended | cancelled
  trialEndsAt     DateTime?
  currentPeriodEnd DateTime?
  // White-label (§55.1)
  commercialName  String?
  brandColor      String?
  logoUrl         String?
  subdomain       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  properties  Property[]
  users       User[]
  legalParameters LegalParameter[]
}

// Planes comerciales del SaaS (§55.1). Solo el superadministrador los gestiona.
model Plan {
  id             String  @id @default(cuid())
  code           String  @unique // trial | basic | pro | enterprise
  name           String
  priceMonthly   Float   @default(0)
  maxUsers       Int     @default(5)
  maxProperties  Int     @default(1)
  maxRooms       Int     @default(30)
  aiMessagesMonth Int    @default(500)
  modules        String  @default("*") // "*" o CSV de módulos habilitados
  active         Boolean @default(true)
  sortOrder      Int     @default(0)
}

// Facturación del software SaaS (§55.1): una factura mensual por empresa.
model SaasInvoice {
  id          String   @id @default(cuid())
  companyId   String
  period      String   // YYYY-MM
  planCode    String
  amount      Float
  status      String   @default("pending") // pending | paid | overdue | void
  issuedAt    DateTime @default(now())
  dueDate     DateTime
  paidAt      DateTime?
  paymentRef  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([companyId, period])
  @@index([companyId, status])
}

model Property {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  name        String
  address     String?
  city        String?
  rnt         String?          // Registro Nacional de Turismo
  rntExpiresAt DateTime?
  checkInTime  String  @default("15:00")
  checkOutTime String  @default("12:00")
  currency    String   @default("COP")
  taxRate     Float    @default(0.19) // IVA por defecto, parametrizable
  timezone    String   @default("America/Bogota")
  whatsappNumber String?
  active      Boolean  @default(true)
  // Servicios/áreas habilitados en esta sede (§55.1). JSON array de claves de
  // servicio; null = todos los servicios disponibles. Cada hotel puede ofrecer
  // un subconjunto distinto (no todos prestan restaurante, eventos, etc.).
  enabledServices String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomTypes     RoomType[]
  rooms         Room[]
  ratePlans     RatePlan[]
  reservations  Reservation[]
  guests        Guest[]
  leads         Lead[]
  conversations Conversation[]
  hkTasks       HousekeepingTask[]
  mtOrders     MaintenanceOrder[]
  payments      Payment[]
  paymentLinks  PaymentLink[]
  approvals     ApprovalRequest[]
  notifications Notification[]
  traRecords    TraRecord[]
  sireReports   SireReport[]
  invoices      Invoice[]
  employees     Employee[]
  payrollPeriods PayrollPeriod[]
}

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  email        String   @unique
  passwordHash String
  name         String
  role         String   // OWNER | MANAGER | FRONTDESK | SALES | HOUSEKEEPING | MAINTENANCE | ACCOUNTING | HR | AUDITOR
  propertyIds  String   @default("*") // "*" = todas las sedes, o lista CSV de ids
  active       Boolean  @default(true)
  // Áreas/servicios a los que el usuario tiene acceso (§55.1). JSON array de
  // claves de servicio; null = todas las áreas que su rol permite. El superadmin
  // define por usuario qué áreas puede ver, más allá de lo que dicta el rol.
  allowedServices String?
  isSuperAdmin Boolean  @default(false) // superadministrador SaaS (§55.1)
  lastLoginAt  DateTime?
  // Seguridad avanzada (§55.3)
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?  // secreto TOTP (base32); nulo si 2FA desactivado
  passwordUpdatedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Recuperación de contraseña (§55.3): token de un solo uso con vencimiento.
model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // hash del token (nunca se guarda en claro)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Sesiones activas (§55.3): permite ver dispositivos y revocar accesos.
model Session {
  id         String   @id @default(cuid())
  userId     String
  jti        String   @unique // id del token JWT emitido
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  revokedAt  DateTime?

  @@index([userId, revokedAt])
}

// Interruptores globales de funciones del sistema (§55.1). El superadministrador
// activa/desactiva un servicio o módulo para TODA la plataforma. Ausente = activo.
// Es el nivel más alto: si aquí está apagado, nadie (salvo el superadmin) lo usa,
// por encima de lo que habilite cada sede o usuario.
model PlatformFeature {
  id        String   @id @default(cuid())
  key       String   @unique // clave de servicio (SERVICE_KEYS) o "module:<id>"
  enabled   Boolean  @default(true)
  note      String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Parámetros legales versionados por vigencia (sección 3 y 6 del documento funcional)
model LegalParameter {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id])
  key        String    // p.ej. SMMLV, UVT, AUX_TRANSPORTE, RECARGO_NOCTURNO, FONTUR_TARIFA
  value      Float
  unit       String?   // COP, %, horas
  validFrom  DateTime
  validTo    DateTime?
  source     String?   // fuente normativa
  updatedBy  String?
  createdAt  DateTime  @default(now())

  @@index([companyId, key, validFrom])
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  propertyId String?
  userId    String?
  userName  String?
  actor     String   @default("human") // human | ai | system
  action    String   // p.ej. reservation.confirmed
  entity    String?
  entityId  String?
  before    String?  // JSON
  after     String?  // JSON
  reason    String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([companyId, createdAt])
}

// Motor de aprobaciones humanas (sección 47: matriz de autorización)
model ApprovalRequest {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  type        String   // manual_payment | refund | discount | rate_override | room_block | reservation_no_deposit | cancellation
  summary     String   // resumen de impacto legible
  payload     String   // JSON con la acción a ejecutar
  requestedBy String?
  requestedByName String?
  requiredRole String  @default("MANAGER") // rol mínimo que aprueba
  status      String   @default("pending") // pending | approved | rejected | expired
  decidedBy   String?
  decidedByName String?
  decisionNote String?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([propertyId, status])
}

model Notification {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  audienceRole String @default("MANAGER") // rol destinatario
  title      String
  body       String?
  severity   String   @default("info") // info | warning | critical
  entity     String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([propertyId, readAt])
}

// Canales de notificación configurables (§44): reenvían las alertas internas a
// email/WhatsApp/webhook según severidad mínima.
model NotificationChannel {
  id          String   @id @default(cuid())
  propertyId  String
  type        String   // email | whatsapp | webhook
  target      String   // dirección de correo, número o URL
  label       String?
  minSeverity String   @default("warning") // info | warning | critical
  audienceRole String? // si se fija, solo reenvía alertas de ese rol
  enabled     Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([propertyId, enabled])
}

model NotificationDelivery {
  id         String   @id @default(cuid())
  propertyId String
  channelId  String
  channelType String
  target     String
  title      String
  severity   String
  status     String   @default("sent") // sent | failed | skipped
  detail     String?
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
}

// ===================== Atria PMS =====================

model RoomType {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  name        String   // Estándar, Superior, Suite...
  code        String
  capacity    Int      @default(2)
  baseRate    Float    // tarifa base por noche (COP)
  description String?
  amenities   String?  // CSV
  // Contenido rico para web y conocimiento del agente (IA-1)
  longDescription String?
  bedConfig   String?  // p.ej. "1 cama king + 1 sofá cama"
  sizeM2      Float?
  view        String?  // ciudad, montaña, interior...
  features    String?  // CSV: wifi, aire, minibar, jacuzzi, balcón...
  active      Boolean  @default(true)
  rooms       Room[]
  ratePlans   RatePlan[]

  @@unique([propertyId, code])
}

// Base de conocimiento del hotel (§55.5): lo que el agente puede consultar.
// visibility=public lo usa el agente externo; internal, los asistentes internos.
model KnowledgeItem {
  id         String   @id @default(cuid())
  propertyId String
  category   String   // faq | service | location | policy | amenity | attraction | general
  title      String
  content    String
  visibility String   @default("public") // public | internal
  tags       String?  // CSV para recuperación
  active     Boolean  @default(true)
  version    Int      @default(1)
  validFrom  DateTime?
  validUntil DateTime?
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  revisions  KnowledgeRevision[]

  @@index([propertyId, visibility, active])
}

// Historial de versiones de un ítem de conocimiento (vigencia, §55.5)
model KnowledgeRevision {
  id              String   @id @default(cuid())
  knowledgeItemId String
  knowledgeItem   KnowledgeItem @relation(fields: [knowledgeItemId], references: [id])
  propertyId      String
  version         Int
  title           String
  content         String
  tags            String?
  editedBy        String?
  createdAt       DateTime @default(now())

  @@index([knowledgeItemId, version])
}

model Room {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  roomTypeId  String
  roomType    RoomType @relation(fields: [roomTypeId], references: [id])
  number      String
  floor       String?
  status      String   @default("clean") // clean | dirty | inspected | occupied | out_of_service
  notes       String?
  active      Boolean  @default(true)
  reservations Reservation[]
  hkTasks     HousekeepingTask[]
  mtOrders    MaintenanceOrder[]

  @@unique([propertyId, number])
}

model RatePlan {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  roomTypeId  String
  roomType    RoomType @relation(fields: [roomTypeId], references: [id])
  name        String   // Flexible, No reembolsable, Corporativa...
  code        String
  price       Float    // por noche
  refundable  Boolean  @default(true)
  minNights   Int      @default(1)
  depositPct  Float    @default(0.5) // anticipo requerido
  validFrom   DateTime?
  validTo     DateTime?
  active      Boolean  @default(true)

  @@unique([propertyId, code])
}

model Guest {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  fullName    String
  documentType String? // CC | CE | PASSPORT | ...
  documentNumber String?
  nationality String?  @default("CO")
  phone       String?
  email       String?
  city        String?
  notes       String?
  language    String?  @default("es")
  memory      String?  // JSON: preferencias, etiquetas, resumen y contexto del huésped (IA-5)
  marketingConsent Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reservations Reservation[]
  leads        Lead[]

  @@index([propertyId, phone])
  @@index([propertyId, documentNumber])
}

model Reservation {
  id          String   @id @default(cuid())
  code        String   @unique // localizador legible p.ej. ATR-2026-000123
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id])
  roomId      String?
  room        Room?    @relation(fields: [roomId], references: [id])
  roomTypeId  String
  ratePlanId  String?
  checkIn     DateTime // fecha llegada (00:00 local)
  checkOut    DateTime // fecha salida
  adults      Int      @default(2)
  children    Int      @default(0)
  nights      Int
  nightlyRate Float
  subtotal    Float
  taxes       Float
  total       Float
  depositRequired Float @default(0)
  channel     String   @default("direct") // direct | whatsapp | web | walkin | ota
  channelRef  String?  // localizador externo (OTA)
  corporateAccountId String?  // cuenta corporativa / agencia (§35)
  status      String   @default("tentative") // tentative | confirmed | checked_in | checked_out | cancelled | no_show | expired
  holdExpiresAt DateTime?
  notes       String?
  createdBy   String?  // userId o "ai"
  // Pre-check-in / check-in digital (§14, §48.2)
  precheckinAt   DateTime?
  arrivalTime    String?
  precheckinData String?  // JSON: acompañantes, hora, políticas firmadas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  folio       Folio?
  payments    Payment[]
  paymentLinks PaymentLink[]
  traRecords  TraRecord[]
  sireReports SireReport[]
  invoices    Invoice[]

  @@index([propertyId, status])
  @@index([propertyId, checkIn])
}

model Folio {
  id            String   @id @default(cuid())
  reservationId String   @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  status        String   @default("open") // open | closed
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  charges       FolioCharge[]
}

model FolioCharge {
  id        String   @id @default(cuid())
  folioId   String
  folio     Folio    @relation(fields: [folioId], references: [id])
  concept   String   // alojamiento | restaurante | minibar | room_service | daño | otro
  description String?
  amount    Float
  taxAmount Float    @default(0)
  postedBy  String?
  voided    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ===================== Atria Pay =====================

model PaymentLink {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  reservationId String?
  reservation  Reservation? @relation(fields: [reservationId], references: [id])
  token        String   @unique
  concept      String
  amount       Float
  currency     String   @default("COP")
  status       String   @default("active") // active | paid | expired | cancelled
  provider     String   @default("mock")   // mock | wompi | mercadopago | bold | stripe
  externalUrl  String?  // URL de checkout de la pasarela externa (si aplica)
  expiresAt    DateTime?
  paidAt       DateTime?
  createdBy    String?
  createdAt    DateTime @default(now())
}

model Payment {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  paymentLinkId String?
  amount        Float
  currency      String   @default("COP")
  method        String   // card | pse | cash | transfer | dataphone | mock
  provider      String?  // mock | wompi | manual
  providerRef   String?  // id transacción pasarela
  status        String   @default("approved") // pending | approved | rejected | refunded
  kind          String   @default("payment") // payment | deposit | refund
  registeredBy  String?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([propertyId, createdAt])
}

// ===================== Centro documental (§43) =====================

model Document {
  id           String   @id @default(cuid())
  companyId    String
  propertyId   String?
  entityType   String?  // Employee | Reservation | Guest | Supplier | Property | Invoice | Contract | Compliance | Other
  entityId     String?
  docType      String   // RUT | RNT | CC | PASSPORT | contract | certificate | policy | invoice | other
  title        String
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  storageKey   String   // ruta relativa en storage/uploads
  version      Int      @default(1)
  supersedesId String?
  issueDate    DateTime?
  expiryDate   DateTime?
  status       String   @default("active") // active | superseded | expired | deleted
  expiryNotifiedAt DateTime?
  uploadedBy   String?
  createdAt    DateTime @default(now())

  @@index([companyId, entityType, entityId])
  @@index([companyId, status, expiryDate])
}

// ===================== Plantillas y políticas (§7) =====================

model MessageTemplate {
  id         String   @id @default(cuid())
  propertyId String
  channel    String   // whatsapp | email | voucher | internal
  name       String
  subject    String?
  body       String   // admite variables {{nombre}}, {{codigo}}, {{total}}...
  lang       String   @default("es")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, name])
}

model HotelPolicy {
  id         String   @id @default(cuid())
  propertyId String
  type       String   // cancellation | checkin | checkout | pets | children | noshow | late_checkout | early_checkin | deposit
  title      String
  conditions String?
  penalty    String?
  publicText String?  // texto para web / motor de reservas / WhatsApp
  active     Boolean  @default(true)
  validFrom  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([propertyId, type])
}

// ===================== Atria IA — Agentes (§41, §54, §55.5) =====================

// Perfil configurable del agente por sede y por ámbito (la "mascota" del hotel).
// scope=guest → agente externo de huéspedes; scope=<AREA> → asistente interno.
model AgentProfile {
  id            String   @id @default(cuid())
  propertyId    String
  scope         String   @default("guest") // guest | reception | housekeeping | maintenance | sales | finance | payroll | manager
  displayName   String   // nombre de la mascota, p.ej. "Lucía de Hotel Atria"
  persona       String?  // instrucciones de personalidad/tono
  tone          String   @default("cálido y profesional")
  languages     String   @default("es")
  emojis        Boolean  @default(true)
  greeting      String?
  domainOnly    Boolean  @default(true) // solo habla de temas del hotel
  llmEnabled    Boolean  @default(true) // usa Claude si hay API key; si no, motor determinístico
  enabledTools  String   @default("*")  // CSV de herramientas permitidas o "*"
  knowledgeScope String  @default("public") // public | internal
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([propertyId, scope])
}

// ===================== Atria Stock — Compras e inventario (§29) =====================

model Supplier {
  id           String   @id @default(cuid())
  propertyId   String
  name         String
  nit          String?
  contact      String?
  category     String?
  paymentTerms String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([propertyId])
}

model Product {
  id         String   @id @default(cuid())
  propertyId String
  sku        String
  name       String
  category   String?  // amenities | limpieza | alimentos | bebidas | minibar | lenceria | repuestos
  unit       String   @default("unidad")
  cost       Float    @default(0)
  stock      Float    @default(0)
  stockMin   Float    @default(0)
  warehouse  String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  movements  StockMovement[]

  @@unique([propertyId, sku])
  @@index([propertyId, category])
}

model StockMovement {
  id         String   @id @default(cuid())
  propertyId String
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  type       String   // in | out | adjustment | consumption
  quantity   Float
  reason     String?
  reference  String?
  unitCost   Float?
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([propertyId, createdAt])
  @@index([productId])
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  propertyId   String
  supplierId   String
  supplierName String
  items        String   // JSON [{productId, name, qty, unitCost, total}]
  total        Float
  status       String   @default("draft") // draft | approved | received | cancelled
  receivedAt   DateTime?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([propertyId, status])
}

// ===================== Atria Finance (§28) =====================

// Cierre de caja (§28): apertura con base, cierre con conteo vs esperado.
model CashClosure {
  id             String   @id @default(cuid())
  propertyId     String
  openedBy       String?
  openedAt       DateTime @default(now())
  openingBalance Float    @default(0)
  status         String   @default("open") // open | closed
  closedBy       String?
  closedAt       DateTime?
  cashPayments   Float?   // efectivo recaudado durante el turno
  expectedCash   Float?   // base + efectivo recaudado
  countedAmount  Float?   // conteo físico
  difference     Float?   // conteo − esperado (descuadre)
  notes          String?

  @@index([propertyId, status])
}

// Conciliación de pagos (§28): sistema vs pasarela/banco.
model Reconciliation {
  id           String   @id @default(cuid())
  propertyId   String
  source       String   @default("gateway") // gateway | bank
  fromDate     DateTime
  toDate       DateTime
  totalSystem  Float    @default(0)
  totalExternal Float   @default(0)
  matched      Int      @default(0)
  unmatched    Int      @default(0)
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([propertyId, createdAt])
}

model AccountPayable {
  id              String   @id @default(cuid())
  propertyId      String
  supplierId      String?
  supplierName    String
  concept         String
  category        String   @default("proveedores") // proveedores | servicios | nomina | impuestos | otros
  amount          Float
  dueDate         DateTime?
  status          String   @default("open") // open | paid
  purchaseOrderId String?
  paidAt          DateTime?
  paymentSupport  String?
  createdBy       String?
  createdAt       DateTime @default(now())

  @@index([propertyId, status])
}

// ===================== Atria — Channel manager (§35) =====================
model Channel {
  id            String   @id @default(cuid())
  propertyId    String
  name          String   // Booking.com, Expedia, Airbnb, Despegar
  code          String   // booking | expedia | airbnb | despegar
  enabled       Boolean  @default(false)
  commissionPct Float    @default(0.15)
  status        String   @default("disconnected") // disconnected | connected | error
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  mappings      ChannelMapping[]
  syncLogs      ChannelSyncLog[]

  @@unique([propertyId, code])
}

model ChannelMapping {
  id           String   @id @default(cuid())
  propertyId   String
  channelId    String
  channel      Channel  @relation(fields: [channelId], references: [id])
  roomTypeId   String
  externalCode String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([propertyId])
  @@index([channelId])
}

model ChannelSyncLog {
  id         String   @id @default(cuid())
  propertyId String
  channelId  String
  channel    Channel  @relation(fields: [channelId], references: [id])
  action     String   // push_availability | push_rates | reservation_received | error | overbooking
  status     String   @default("ok") // ok | error | warning
  detail     String?
  createdAt  DateTime @default(now())

  @@index([channelId, createdAt])
}

// ===================== Atria Revenue (§34) =====================
model PricingRule {
  id            String   @id @default(cuid())
  propertyId    String
  name          String
  roomTypeId    String?  // null = aplica a todos
  occupancyGte  Float?   // si ocupación >= X → aplicar ajuste
  occupancyLte  Float?   // si ocupación <= X → aplicar ajuste
  daysAheadLte  Int?     // solo si faltan <= N días (last minute)
  adjustPct     Float    // +0.15 sube 15%, -0.10 baja 10%
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([propertyId, active])
}

// ===================== Web / CMS público (§9) =====================
model SiteSettings {
  id           String   @id @default(cuid())
  propertyId   String   @unique
  heroTitle    String?
  heroSubtitle String?
  aboutText    String?
  promoText    String?
  heroImageId  String?  // documento imagen (docType=image)
  published    Boolean  @default(true)
  updatedAt    DateTime @updatedAt
}

// ===================== Atria Service — Restaurante/POS (§32) =====================

model MenuItem {
  id         String   @id @default(cuid())
  propertyId String
  name       String
  category   String   @default("comida") // comida | bebida | minibar | postre
  price      Float
  recipe     String?  // JSON [{productId, qty}] para costeo/descuento de inventario
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([propertyId, active])
}

model PosOrder {
  id            String   @id @default(cuid())
  propertyId    String
  type          String   @default("table") // table | room_service | minibar
  tableLabel    String?
  reservationId String?
  items         String   // JSON [{menuItemId, name, qty, price, total}]
  subtotal      Float
  tax           Float
  total         Float
  status        String   @default("open") // open | charged | paid | void
  method        String?
  createdBy     String?
  chargedAt     DateTime?
  createdAt     DateTime @default(now())

  @@index([propertyId, status])
}

// ===================== SG-SST (§25) =====================

model SgsstRiskItem {
  id          String   @id @default(cuid())
  propertyId  String
  area        String
  position    String?
  hazard      String   // peligro
  risk        String   // riesgo
  control     String?
  responsible String?
  createdAt   DateTime @default(now())

  @@index([propertyId])
}

model SgsstIncident {
  id           String   @id @default(cuid())
  propertyId   String
  employeeId   String?
  employeeName String?
  date         DateTime
  type         String   // accidente | incidente | enfermedad | casi_accidente
  description  String
  severity     String   @default("leve") // leve | grave | mortal
  evidence     String?
  actions      String?
  status       String   @default("open") // open | closed
  createdBy    String?
  closedAt     DateTime?
  createdAt    DateTime @default(now())

  @@index([propertyId, status])
}

model MedicalExam {
  id           String   @id @default(cuid())
  propertyId   String
  employeeId   String
  employeeName String
  type         String   // ingreso | periodico | egreso
  date         DateTime
  validUntil   DateTime?
  result       String?
  restrictions String?
  documentId   String?
  notifiedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([propertyId, validUntil])
}

model SgsstTraining {
  id           String   @id @default(cuid())
  propertyId   String
  title        String
  date         DateTime
  attendees    String?  // JSON [{id,name}]
  evidenceDocId String?
  validUntil   DateTime?
  createdAt    DateTime @default(now())

  @@index([propertyId])
}

model PpeDelivery {
  id           String   @id @default(cuid())
  propertyId   String
  employeeId   String
  employeeName String
  item         String
  quantity     Int      @default(1)
  date         DateTime
  notes        String?
  createdAt    DateTime @default(now())

  @@index([propertyId])
}

// ===================== Motor de reglas legales (§39) =====================

model ComplianceRule {
  id          String   @id @default(cuid())
  companyId   String
  propertyId  String?
  key         String   // rnt_expiry | doc_expiry | tra_incomplete | sire_pending | contract_expiry
  name        String
  description String?
  severity    String   @default("warning") // info | warning | critical
  thresholdDays Int?   // días de anticipación para alertar vencimientos
  audienceRole String  @default("MANAGER")
  active      Boolean  @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, active])
}

// ===================== Atria Fiscal (facturación — Dataico) =====================

model Invoice {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  reservationId String?
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  prefix        String?
  number        Int?
  fullNumber    String?  // p.ej. ATR-1001
  customerName  String
  customerDoc   String?
  customerEmail String?
  items         String   // JSON [{description, qty, price, taxRate, taxAmount, total}]
  subtotal      Float
  tax           Float
  total         Float
  status        String   @default("draft") // draft | pending | validated | rejected | error | annulled
  provider      String   @default("dataico")
  providerRef   String?  // uuid Dataico
  cufe          String?
  errorMsg      String?
  issuedAt      DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId, status])
}

// Notas crédito/débito (§16): ajustan o anulan una factura emitida.
model FiscalNote {
  id          String   @id @default(cuid())
  propertyId  String
  invoiceId   String
  type        String   // credit | debit
  reason      String
  amount      Float
  fullNumber  String?  // NC-1001 / ND-1001
  status      String   @default("draft") // draft | issued
  provider    String   @default("dataico")
  providerRef String?
  cude        String?  // código único documento electrónico (nota)
  issuedAt    DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([propertyId, invoiceId])
}

// ===================== Atria People (RR. HH. + Nómina) =====================

model Employee {
  id             String   @id @default(cuid())
  companyId      String
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id])
  fullName       String
  documentType   String   @default("CC")
  documentNumber String
  email          String?
  phone          String?
  position       String   // cargo
  area           String?  // recepción, housekeeping, cocina...
  contractType   String   @default("indefinido") // indefinido | fijo | obra | aprendizaje
  salary         Float    // salario mensual base
  hireDate       DateTime
  endDate        DateTime?
  eps            String?
  afp            String?
  arl            String?
  ccf            String?
  cesantiasFund  String?
  riskClass      Int      @default(1) // clase de riesgo ARL 1-5
  bankAccount    String?
  status         String   @default("active") // active | terminated
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  novelties      PayrollNovelty[]
  payrollItems   PayrollItem[]
  contracts      EmploymentContract[]
  shifts         ShiftAssignment[]
  attendance     AttendanceRecord[]

  @@unique([companyId, documentNumber])
  @@index([propertyId, status])
}

// Turnos / cuadrantes (§21)
model ShiftAssignment {
  id         String   @id @default(cuid())
  propertyId String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  date       DateTime
  startTime  String   // "14:00"
  endTime    String   // "22:00"
  area       String?
  notes      String?
  status     String   @default("planned") // planned | done | absent
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([propertyId, date])
  @@index([employeeId, date])
}

// Marcación de asistencia (§21); al cerrar genera novedades de recargo/extra.
model AttendanceRecord {
  id            String   @id @default(cuid())
  propertyId    String
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id])
  date          DateTime
  clockIn       DateTime
  clockOut      DateTime?
  hoursWorked   Float?
  nightHours    Float?
  overtimeHours Float?
  source        String   @default("panel")
  createdAt     DateTime @default(now())

  @@index([propertyId, date])
  @@index([employeeId, date])
}

// Contratos laborales (§20): documento formal, prórrogas y otrosíes.
model EmploymentContract {
  id           String   @id @default(cuid())
  companyId    String
  propertyId   String
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id])
  type         String   @default("indefinido") // indefinido | fijo | obra | aprendizaje
  position     String
  salary       Float
  workday      String   @default("Tiempo completo")
  functions    String?
  startDate    DateTime
  endDate      DateTime?
  trialEndDate DateTime?
  status       String   @default("draft") // draft | active | ended
  documentId   String?  // contrato firmado en el centro documental
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  amendments   ContractAmendment[]

  @@index([propertyId, status])
  @@index([employeeId])
}

model ContractAmendment {
  id            String   @id @default(cuid())
  contractId    String
  contract      EmploymentContract @relation(fields: [contractId], references: [id])
  changeType    String   // salary | position | workday | functions | extension
  detail        String
  previousValue String?
  newValue      String?
  effectiveDate DateTime
  reason        String?
  createdBy     String?
  createdAt     DateTime @default(now())
}

// Novedades de nómina: horas extras, recargos, ausencias, bonos, deducciones
model PayrollNovelty {
  id         String   @id @default(cuid())
  propertyId String
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  type       String   // overtime_day | overtime_night | night_surcharge | sunday_holiday | absence | incapacity | vacation | bonus | commission | deduction | loan
  date       DateTime
  hours      Float?   // para horas extras/recargos
  days       Float?   // para ausencias/incapacidades/vacaciones
  amount     Float?   // para bonos/comisiones/deducciones/préstamos
  notes      String?
  status     String   @default("pending") // pending | approved | rejected
  approvedBy String?
  periodId   String?  // periodo en que fue liquidada
  createdAt  DateTime @default(now())

  @@index([propertyId, status])
  @@index([employeeId, date])
}

model PayrollPeriod {
  id          String   @id @default(cuid())
  companyId   String
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  year        Int
  month       Int      // 1-12
  status      String   @default("open") // open | calculated | closed
  totalEarned Float?
  totalDeductions Float?
  totalNet    Float?
  totalEmployerCost Float?
  calculatedAt DateTime?
  closedAt    DateTime?
  closedBy    String?
  createdAt   DateTime @default(now())
  items       PayrollItem[]

  @@unique([propertyId, year, month])
}

// Nómina electrónica DIAN (§22): documento soporte de pago por empleado.
model ElectronicPayrollDocument {
  id           String   @id @default(cuid())
  companyId    String
  propertyId   String
  periodId     String
  employeeId   String
  employeeName String
  number       Int?
  fullNumber   String?
  cune         String?  // código único del documento soporte (solo con proveedor)
  earned       Float
  deductions   Float
  net          Float
  payload      String   // JSON de devengados/deducidos
  status       String   @default("generated") // generated | pending | validated | error
  providerRef  String?
  errorMsg     String?
  issuedAt     DateTime?
  createdBy    String?
  createdAt    DateTime @default(now())

  @@index([propertyId, periodId])
}

// PILA / seguridad social (§23): planilla de aportes derivada de un periodo.
model PilaFile {
  id                 String   @id @default(cuid())
  companyId          String
  propertyId         String
  periodId           String   @unique
  year               Int
  month              Int
  status             String   @default("prepared") // prepared | paid
  employeeCount      Int
  totalIBC           Float
  totalContributions Float
  rows               String   // JSON por empleado
  inconsistencies    String?  // JSON de afiliaciones faltantes
  paymentSupport     String?
  paidAt             DateTime?
  preparedBy         String?
  createdAt          DateTime @default(now())

  @@index([propertyId, year, month])
}

model PayrollItem {
  id         String   @id @default(cuid())
  periodId   String
  period     PayrollPeriod @relation(fields: [periodId], references: [id])
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  daysWorked Float
  breakdown  String   // JSON detallado: devengados, deducciones, costos patronales, provisiones
  earned     Float    // total devengado
  deductions Float    // total deducciones empleado
  net        Float    // neto a pagar
  employerCost Float  // costo patronal total (seguridad social + parafiscales + provisiones)
  createdAt  DateTime @default(now())

  @@unique([periodId, employeeId])
}

// ===================== Atria Connect (CRM + Inbox) =====================

model Lead {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  guestId     String?
  guest       Guest?   @relation(fields: [guestId], references: [id])
  name        String?
  phone       String?
  email       String?
  channel     String   @default("whatsapp") // whatsapp | web | instagram | email | phone
  intent      String?  // reserva | evento | queja | info
  checkIn     DateTime?
  checkOut    DateTime?
  adults      Int?
  score       Int      @default(0)
  stage       String   @default("new") // new | qualified | quoted | won | lost
  lostReason  String?
  assignedTo  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId, stage])
}

// Segmento dinámico de huéspedes para marketing/CRM (§12/§36)
model GuestSegment {
  id          String   @id @default(cuid())
  propertyId  String
  name        String
  description String?
  criteria    String   // JSON: minStays, city, nationality, marketingConsent, lastStayWithinDays, inactiveDays, minSpend, language
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId])
}

// Cuenta corporativa / agencia con tarifa negociada y crédito (§35)
model CorporateAccount {
  id             String   @id @default(cuid())
  propertyId     String
  name           String
  nit            String?  // NIT / identificación tributaria
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  discountPct    Float    @default(0) // descuento negociado sobre tarifa (0..1)
  creditEnabled  Boolean  @default(false)
  creditLimit    Float    @default(0)
  paymentTermsDays Int    @default(30)
  status         String   @default("active") // active | suspended
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([propertyId, status])
}

// Rooming list: reserva de grupo con múltiples huéspedes/habitaciones (§35)
model RoomingList {
  id                 String   @id @default(cuid())
  propertyId         String
  corporateAccountId String?
  name               String
  checkIn            DateTime
  checkOut           DateTime
  roomTypeId         String
  ratePlanId         String?
  status             String   @default("draft") // draft | materialized | cancelled
  notes              String?
  createdBy          String?
  createdAt          DateTime @default(now())
  entries            RoomingEntry[]

  @@index([propertyId, status])
}

model RoomingEntry {
  id            String   @id @default(cuid())
  roomingListId String
  roomingList   RoomingList @relation(fields: [roomingListId], references: [id])
  guestName     String
  documentNumber String?
  adults        Int      @default(1)
  children      Int      @default(0)
  reservationId String?  // se llena al materializar
  status        String   @default("pending") // pending | reserved
  createdAt     DateTime @default(now())
}

model Conversation {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  channel     String   // whatsapp | webchat
  contactId   String   // jid whatsapp o identificador webchat
  contactName String?
  contactPhone String?
  status      String   @default("open") // open | closed
  aiEnabled   Boolean  @default(true)   // false = tomada por humano
  assignedTo  String?
  lastMessageAt DateTime @default(now())
  summary     String?  // resumen de la conversación para escalamiento a humano (IA-5)
  context     String?  // JSON: estado conversacional del bot (fechas, cotización, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    Message[]

  @@unique([propertyId, channel, contactId])
  @@index([propertyId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  direction      String   // in | out
  sender         String   // guest | ai | nombre de usuario
  body           String
  intent         String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

// ===================== Atria Ops =====================

model HousekeepingTask {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  type       String   @default("checkout_clean") // checkout_clean | stayover | deep_clean | request
  priority   String   @default("normal") // low | normal | high | urgent
  status     String   @default("pending") // pending | in_progress | done | inspected
  assignedTo String?
  notes      String?
  checklist  String?  // JSON [{ item, done }] — protocolo de limpieza por tipo
  createdAt  DateTime @default(now())
  completedAt DateTime?

  @@index([propertyId, status])
}

// Objetos perdidos y encontrados (§30)
model LostItem {
  id            String   @id @default(cuid())
  propertyId    String
  roomId        String?
  reservationId String?
  description   String
  location      String?  // dónde se encontró
  status        String   @default("stored") // stored | claimed | returned | discarded
  foundBy       String?
  foundAt       DateTime @default(now())
  claimedBy     String?  // nombre del huésped que reclama
  resolvedBy    String?
  resolvedAt    DateTime?
  notes         String?

  @@index([propertyId, status])
}

model MaintenanceOrder {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  roomId     String?
  room       Room?    @relation(fields: [roomId], references: [id])
  assetId    String?  // activo asociado (§31)
  preventive Boolean  @default(false) // orden generada por plan preventivo
  title      String
  description String?
  priority   String   @default("medium") // low | medium | high | critical
  status     String   @default("open") // open | in_progress | resolved | closed
  blocksRoom Boolean  @default(false)
  reportedBy String?
  assignedTo String?
  cost       Float?
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@index([propertyId, status])
}

// Activos e infraestructura con mantenimiento preventivo (§31)
model Asset {
  id            String   @id @default(cuid())
  propertyId    String
  name          String
  category      String   @default("other") // hvac | elevator | boiler | kitchen | pool | electrical | furniture | other
  location      String?
  serial        String?
  brand         String?
  status        String   @default("operational") // operational | needs_service | out_of_service | retired
  intervalDays  Int?     // cadencia del plan preventivo
  lastServiceAt DateTime?
  nextServiceAt DateTime?
  notes         String?
  createdAt     DateTime @default(now())

  @@index([propertyId, status])
}

// ===================== Atria Compliance =====================

// Tarjeta de Registro de Alojamiento (TRA)
model TraRecord {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  guestName     String
  documentType  String?
  documentNumber String?
  nationality   String?
  originCity    String?
  destinationCity String?
  travelReason  String?  // negocios | turismo | evento | otro
  isMainGuest   Boolean  @default(true)
  status        String   @default("incomplete") // incomplete | complete
  missingFields String?  // CSV de campos faltantes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId, status])
}

// Reportes SIRE para extranjeros
model SireReport {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id])
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  guestName     String
  nationality   String
  documentType  String?
  documentNumber String?
  status        String   @default("pending") // pending | prepared | reported | error | not_applicable
  reportedBy    String?
  reportedAt    DateTime?
  supportNote   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId, status])
}

// ===== Protección de datos / Habeas Data (§26, Ley 1581/2012 + RNBD) =====

// Registro de consentimientos del titular (huésped, empleado, lead).
model DataConsent {
  id           String   @id @default(cuid())
  propertyId   String
  subjectType  String   // guest | employee | lead
  subjectId    String?  // id interno del titular (opcional)
  subjectName  String
  documentNumber String?
  purpose      String   // marketing | tratamiento | imagen | datos_sensibles | transferencia
  granted      Boolean  @default(true)
  channel      String?  // recepcion | web | whatsapp | contrato | correo
  policyVersion String?
  source       String?  // nota o referencia de dónde se capturó
  grantedAt    DateTime @default(now())
  revokedAt    DateTime?
  createdBy    String?

  @@index([propertyId, subjectType])
  @@index([propertyId, documentNumber])
}

// Solicitudes del titular (derechos ARCO / habeas data): acceso, rectificación,
// supresión, oposición, revocación. Plazo legal por defecto: 15 días hábiles.
model DataSubjectRequest {
  id           String   @id @default(cuid())
  propertyId   String
  subjectType  String   @default("guest")
  subjectName  String
  documentNumber String?
  email        String?
  type         String   // acceso | rectificacion | supresion | oposicion | revocacion
  channel      String?  // web | correo | recepcion | whatsapp | telefono
  detail       String?
  status       String   @default("received") // received | in_progress | resolved | rejected
  dueDate      DateTime?
  resolution   String?
  resolvedBy   String?
  resolvedAt   DateTime?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([propertyId, status])
}

// Inventario de bases de datos (Registro Nacional de Bases de Datos - RNBD).
model DataTreatment {
  id              String  @id @default(cuid())
  propertyId      String
  name            String  // p.ej. Huéspedes, Empleados, CRM/Leads
  purpose         String
  legalBasis      String? // consentimiento | contrato | obligacion_legal
  categories      String? // categorías de datos tratados
  retention       String? // política de retención
  security        String? // medidas de seguridad
  responsible     String? // responsable/encargado
  registeredRnbd  Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([propertyId, name])
}

// ===== FONTUR — contribución parafiscal del turismo (§27, Ley 2068/2020) =====
// Aporte trimestral sobre ingresos operacionales (tarifa versionada en
// LegalParameter FONTUR_TARIFA, p.ej. 2.5 por mil para hoteles).
model FonturContribution {
  id              String   @id @default(cuid())
  propertyId      String
  period          String   // p.ej. 2026-T3
  periodStart     DateTime
  periodEnd       DateTime
  operatingIncome Float    // base gravable del trimestre
  rate            Float    // tarifa aplicada (versionada)
  amount          Float    // contribución = base * tarifa
  status          String   @default("draft") // draft | filed | paid
  filedAt         DateTime?
  paidAt          DateTime?
  support         String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([propertyId, period])
}

// ===== Marketing & campañas (§36) =====
// Campañas segmentadas por canal; el envío respeta el consentimiento de
// marketing del titular (§26) — no se contacta a quien no lo autorizó.
model Campaign {
  id            String   @id @default(cuid())
  propertyId    String
  name          String
  channel       String   @default("email") // email | whatsapp | sms
  audience      String   @default("guests") // guests | leads
  segment       String?  // JSON con criterios (ciudad, etapa, etiqueta…)
  subject       String?
  message       String
  status        String   @default("draft") // draft | scheduled | sent | cancelled
  scheduledAt   DateTime?
  sentAt        DateTime?
  audienceCount Int      @default(0)
  sentCount     Int      @default(0)
  skippedNoConsent Int   @default(0)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId, status])
}

// Cupones promocionales con atribución a campaña para ROI (§36)
model Coupon {
  id             String   @id @default(cuid())
  propertyId     String
  code           String
  description    String?
  discountType   String   @default("percent") // percent | fixed
  discountValue  Float     // % (0..100) o valor fijo COP
  campaignId     String?   // atribución para ROI
  maxRedemptions Int?
  redemptions    Int      @default(0)
  minNights      Int      @default(1)
  validFrom      DateTime?
  validTo        DateTime?
  active         Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())
  redemptionLog  CouponRedemption[]

  @@unique([propertyId, code])
}

model CouponRedemption {
  id               String   @id @default(cuid())
  couponId         String
  coupon           Coupon   @relation(fields: [couponId], references: [id])
  propertyId       String
  reservationId    String?
  guestName        String?
  amountDiscounted Float    @default(0)
  reservationTotal Float    @default(0)
  createdAt        DateTime @default(now())

  @@index([propertyId, couponId])
}

// ===== Reputación & reseñas (§37) =====
model Review {
  id            String   @id @default(cuid())
  propertyId    String
  reservationId String?
  guestId       String?
  guestName     String
  source        String   @default("direct") // direct | google | booking | tripadvisor | expedia
  rating        Int      // 1..5
  title         String?
  comment       String?
  sentiment     String   @default("neutral") // positive | neutral | negative
  status        String   @default("published") // published | responded | hidden
  response      String?
  respondedBy   String?
  respondedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([propertyId, status])
  @@index([propertyId, source])
}

// Encuestas post-estadía (§37): NPS + dimensiones; una por reserva.
model Survey {
  id            String   @id @default(cuid())
  propertyId    String
  reservationId String   @unique
  guestName     String
  status        String   @default("sent") // sent | responded
  nps           Int?     // 0..10
  ratingClean   Int?     // 1..5
  ratingService Int?     // 1..5
  ratingComfort Int?     // 1..5
  comment       String?
  sentAt        DateTime @default(now())
  respondedAt   DateTime?

  @@index([propertyId, status])
}

// Quejas / casos internos (§37): clasificación, causa raíz y acción correctiva.
model Complaint {
  id            String   @id @default(cuid())
  propertyId    String
  reservationId String?
  surveyId      String?
  guestName     String
  category      String   @default("otro") // limpieza | servicio | ruido | facturacion | mantenimiento | otro
  detail        String?
  severity      String   @default("medium") // low | medium | high
  status        String   @default("open") // open | in_progress | resolved
  rootCause     String?
  correctiveAction String?
  source        String   @default("survey") // survey | review | manual
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([propertyId, status])
}

// ===== Eventos & corporativo (§33) — salones y montajes =====
model Venue {
  id           String   @id @default(cuid())
  propertyId   String
  name         String
  capacity     Int      @default(0)
  halfDayRate  Float    @default(0)
  fullDayRate  Float    @default(0)
  hourlyRate   Float    @default(0)
  amenities    String?  // texto libre: proyector, sonido, catering…
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       EventBooking[]

  @@index([propertyId, active])
}

model EventBooking {
  id              String   @id @default(cuid())
  code            String   @unique // EVT-2026-000123
  propertyId      String
  venueId         String
  venue           Venue    @relation(fields: [venueId], references: [id])
  leadId          String?
  clientName      String
  clientContact   String?
  eventType       String   @default("corporativo") // corporativo | social | boda | capacitacion
  date            DateTime
  startTime       String   @default("08:00")
  endTime         String   @default("17:00")
  attendees       Int      @default(0)
  setup           String   @default("auditorio") // auditorio | escuela | banquete | coctel | u
  durationType    String   @default("full") // full | half | hourly
  hours           Int      @default(0)
  venueFee        Float    @default(0)
  cateringPerPerson Float  @default(0)
  cateringTotal   Float    @default(0)
  extras          Float    @default(0)
  extrasNote      String?
  subtotal        Float    @default(0)
  taxes           Float    @default(0)
  total           Float    @default(0)
  deposit         Float    @default(0)
  status          String   @default("quote") // quote | confirmed | in_progress | completed | cancelled
  notes           String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([propertyId, status])
  @@index([propertyId, date])
}

// ===== Centro de integraciones (§45) — conectores externos =====
model Integration {
  id            String   @id @default(cuid())
  propertyId    String
  provider      String   // mercadopago | bold | stripe | wompi | dataico | booking | whatsapp | ga4 | webhook
  category      String   // payments | invoicing | channel | messaging | analytics | other
  name          String
  status        String   @default("disconnected") // connected | disconnected | error
  config        String?  // JSON con credenciales (secretos enmascarados al leer)
  enabled       Boolean  @default(true)
  lastCheckedAt DateTime?
  lastError     String?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([propertyId, provider])
  @@index([propertyId, category])
}

// ===== Automatizador visual (§40) — reglas no-code sobre el bus de eventos =====
model AutomationRule {
  id          String   @id @default(cuid())
  propertyId  String
  name        String
  trigger     String   // nombre del evento de dominio (reservation.confirmed…)
  conditions  String?  // JSON: [{field, op, value}]
  actionType  String   // notify | housekeeping_task | log | multi
  actionParams String? // JSON con parámetros de la acción (modo simple)
  steps       String?  // JSON: [{type, params}] — secuencia multi-paso (§40)
  enabled     Boolean  @default(true)
  runCount    Int      @default(0)
  lastRunAt   DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([propertyId, enabled])
  @@index([propertyId, trigger])
}

// ===== Portal del huésped (§14) — solicitudes de servicio =====
model GuestRequest {
  id            String   @id @default(cuid())
  propertyId    String
  reservationId String?
  guestName     String
  roomNumber    String?
  type          String   // cleaning | towels | amenities | room_service | maintenance | checkout | other
  detail        String?
  status        String   @default("pending") // pending | in_progress | done | cancelled
  channel       String   @default("portal") // portal | whatsapp | recepcion
  resolvedBy    String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([propertyId, status])
}
