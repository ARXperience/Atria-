{
  "name": "atria-hospitality-os",
  "version": "0.1.0",
  "description": "Atria Hospitality OS — ecosistema hotelero integral con IA para Colombia (PMS, Booking, CRM, WhatsApp IA por Baileys, pagos, cumplimiento)",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
