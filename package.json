    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "prisma": "^6.16.0"
  },
  "engines": {
    "node": ">=20"
  }
}
