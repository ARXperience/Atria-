# ===== Atria Hospitality OS — configuración =====

# Puerto HTTP del servidor (API + panel admin)
PORT=4000

# Base de datos (SQLite por defecto; para producción usar PostgreSQL:
# DATABASE_URL="postgresql://user:pass@host:5432/atria")
DATABASE_URL="file:./data/atria.db"

# Secreto JWT (cambiar en producción)
JWT_SECRET="cambia-este-secreto-en-produccion"

# Horas de expiración de reservas tentativas sin pago
TENTATIVE_HOLD_HOURS=24

# URL pública base (para links de pago y portal del huésped)
PUBLIC_BASE_URL="http://localhost:4000"

# ===== WhatsApp (Baileys) =====
# Se activa desde el panel (Inbox > WhatsApp > Conectar). No requiere variables,
# la sesión se guarda en storage/wa-sessions/<propertyId>.
# Poner en "false" para deshabilitar el módulo completo.
WHATSAPP_ENABLED=true

# ===== IA (opcional) =====
# Si se configura, el asistente usa Claude para conversaciones naturales.
# Sin API key, funciona el motor determinístico de intenciones (igualmente funcional).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-5"

# ===== Pasarela de pagos =====
# Modo "mock" incluye un simulador de pagos funcional (checkout local).
# Para Wompi: PAYMENT_PROVIDER=wompi + llaves.
PAYMENT_PROVIDER=mock
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
