# ===== Atria Hospitality OS — configuración =====

# Puerto HTTP del servidor (API + panel admin)
PORT=4000

# Base de datos (SQLite por defecto; para producción usar PostgreSQL:
# DATABASE_URL="postgresql://user:pass@host:5432/atria")
DATABASE_URL="file:./data/atria.db"

# Secreto JWT (cambiar en producción)
JWT_SECRET="cambia-este-secreto-en-produccion"

# Contraseña de los usuarios sembrados por `npm run setup`.
# Si se omite, se usa "atria2026" SOLO para la demo local.
# En producción define una contraseña fuerte aquí (o cámbialas tras el primer arranque).
SEED_PASSWORD=

# Horas de expiración de reservas tentativas sin pago
TENTATIVE_HOLD_HOURS=24

# URL pública base (para links de pago y portal del huésped)
PUBLIC_BASE_URL="http://localhost:4000"

# ===== WhatsApp (Baileys) =====
# Se activa desde el panel (Inbox > WhatsApp > Conectar). No requiere variables,
# la sesión se guarda en storage/wa-sessions/<propertyId>.
# Poner en "false" para deshabilitar el módulo completo.
WHATSAPP_ENABLED=true

# ===== IA (opcional) =====
# Si se configura, el asistente usa Claude para conversaciones naturales.
# Sin API key, funciona el motor determinístico de intenciones (igualmente funcional).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-sonnet-5"

# ===== Pasarelas de pago (multi-pasarela conectable) =====
# PAYMENT_PROVIDER define la pasarela POR DEFECTO para nuevos links de pago:
#   mock | wompi | mercadopago | bold | stripe
# Puedes configurar varias a la vez y elegir por link (parámetro "provider").
# "mock" incluye un simulador de checkout funcional (sin credenciales).
PAYMENT_PROVIDER=mock

# --- Wompi (Bancolombia) — https://comercios.wompi.co ---
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=

# --- Mercado Pago — https://www.mercadopago.com.co/developers ---
# Webhook a registrar: <PUBLIC_BASE_URL>/api/public/webhooks/payments/mercadopago
MP_ACCESS_TOKEN=

# --- Bold — https://developers.bold.co ---
# Webhook a registrar: <PUBLIC_BASE_URL>/api/public/webhooks/payments/bold
BOLD_API_KEY=
BOLD_SECRET_KEY=

# --- Stripe — https://dashboard.stripe.com/apikeys ---
# Webhook a registrar: <PUBLIC_BASE_URL>/api/public/webhooks/payments/stripe
# (evento: checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Facturación electrónica (Dataico) =====
# Sin credenciales, las facturas quedan como borrador/numeración local.
# Con credenciales se transmiten a la DIAN vía Dataico.
DATAICO_AUTH_TOKEN=
DATAICO_ACCOUNT_ID=
DATAICO_INVOICE_PREFIX=ATR
DATAICO_ENV=test
